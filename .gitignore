# ============================================================
# FinançasPro — Git Ignore Rules
# ============================================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env
*.pem
*.pfx
*.p12
*.key

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*.iml
.classpath
.project
.settings/

# Java & Maven
target/
*.class
*.jar
*.war
*.ear
*.rar
.mvn/wrapper/maven-wrapper.jar

# Node.js & Frontend
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS Generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Local Data
*.log
uploads/
tmp/
scratch/
