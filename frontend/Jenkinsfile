pipeline {
    agent any

    environment {
        APP_NAME = 'frontendfinancaspro'
        PORT_HML = '3004'
        PORT_PRD = '3003'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Lint') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run lint'
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('frontend') {
                    sh "docker build -t ${APP_NAME}:${env.BUILD_NUMBER} ."
                    sh "docker tag ${APP_NAME}:${env.BUILD_NUMBER} ${APP_NAME}:latest"
                }
            }
        }

        stage('Deploy HML') {
            when {
                branch 'master'
            }
            steps {
                sh "docker stop ${APP_NAME} || true"
                sh "docker rm ${APP_NAME} || true"
                sh "docker run -d --name ${APP_NAME} --network jenkins_jenkins_net -p ${PORT_HML}:3000 -e NEXT_PUBLIC_API_URL=http://localhost:8087 ${APP_NAME}:latest"
            }
        }

        stage('Deploy PRD') {
            when {
                branch 'production'
            }
            steps {
                sh "docker stop ${APP_NAME}-prd || true"
                sh "docker rm ${APP_NAME}-prd || true"
                sh "docker run -d --name ${APP_NAME}-prd --network jenkins_jenkins_net -p ${PORT_PRD}:3000 -e NEXT_PUBLIC_API_URL=http://localhost:8087 ${APP_NAME}:latest"
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
