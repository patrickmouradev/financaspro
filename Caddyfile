# ============================================================
# Caddyfile — Configuração do Proxy Reverso para FinançasPro
# Rede Docker: jenkins_jenkins_net
# ============================================================

financaslocal.duckdns.org {
    # Aponta direto para o container do backend na rede Docker
    # (Nota: Usamos 'handle /api/*' para manter o prefixo /api que o Spring Boot espera)
    handle /api/* {
        reverse_proxy backendfinancaspro:8087 {
            header_up -Origin
        }
    }

    # Aponta direto para o container do frontend na rede Docker (porta interna 3000 do Next.js)
    handle {
        reverse_proxy frontendfinancaspro:3000
    }
}
