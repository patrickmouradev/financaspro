# ============================================================
# FinançasPro — Variáveis de Ambiente (.env.example)
# Copie para .env e preencha com os valores reais do ambiente.
# NUNCA commite o arquivo .env no git.
# ============================================================

# === BANCO DE DADOS (PostgreSQL compartilhado no servidor) ===
DB_HOST=192.168.15.10
DB_PORT=5432
DB_NAME=financaspro
DB_USERNAME=financaspro_user
DB_PASSWORD=SUA_SENHA_AQUI

# === AUTENTICAÇÃO JWT ===
# Deve conter no mínimo 64 caracteres aleatórios
JWT_SECRET=DIGITE_UMA_CHAVE_JWT_SUPER_SEGURA_COM_NO_MINIMO_64_CARACTERES_ALEATORIOS
JWT_EXPIRATION_MS=86400000

# === AMBIENTE SPRING BOOT ===
# Valores aceitos: hml | prd
SPRING_PROFILES_ACTIVE=hml

# === APIs EXTERNAS ===
# BRAPI token (opcional — se não fornecido usa cotações gratuitas com rate limit padrão)
BRAPI_TOKEN=

# === CORS & URLs DE REDE ===
# HML: http://localhost:3004 | PRD: http://192.168.15.10:3003
CORS_ORIGINS=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:8087
UPLOAD_DIR=/app/uploads
